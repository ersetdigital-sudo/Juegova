# Origin canonical situs. Dipakai metadata (metadataBase), sitemap.xml, dan robots.txt.
# Di produksi, set lewat dashboard hosting atau file .env.local.
NEXT_PUBLIC_SITE_URL=https://juegova.net

# Password untuk masuk ke /admin. SELAMA INI KOSONG, DASHBOARD TERBUKA TANPA LOGIN.
# WAJIB diisi sebelum menyambungkan Supabase, supaya tidak ada yang bisa mengubah
# harga dari luar.
ADMIN_PASSWORD=

# Opsional. Kalau kosong, dipakai turunan dari ADMIN_PASSWORD.
# Isi kalau ingin mengganti password tanpa membuat semua sesi lama tetap valid.
ADMIN_SESSION_SECRET=

# Opsional. Kalau dua variabel ini diisi, konten disimpan di Supabase, bukan file lokal.
# Tabel yang dibutuhkan:
#   create table if not exists site_content (
#     id text primary key,
#     data jsonb not null,
#     updated_at timestamptz not null default now()
#   );
# Pakai service role key (server-side saja, jangan pernah diekspos ke browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary untuk upload gambar dari dashboard admin (QRIS, banner, sampul game).
# Dipakai lewat unsigned upload, jadi API secret TIDAK dibutuhkan dan sengaja
# tidak disimpan di sini — cukup cloud name + nama upload preset.
# Buat preset-nya sebagai "Unsigned" di Cloudinary → Settings → Upload.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
